{
    "name": "dbseller/superclosure",
    "type": "library",
    "description": "Serialize Closure objects, including their context and binding",
    "keywords": [
        "closure",
        "serialize",
        "serializable",
        "function",
        "parser",
        "tokenizer",
        "lambda"
    ],
    "homepage": "https://github.com/DBSeller/superclosure",
    "license": "MIT",
    "authors": [
        {
            "name": "Jeremy Lindblom",
            "email": "jeremeamia@gmail.com",
            "homepage": "https://github.com/jeremeamia",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^7.4 || ^8.0 || ^8.1 || ^8.2 || ^8.3 || ^8.4 || ^8.5",
        "nikic/php-parser": "^4.18 || ^5.0",
        "symfony/polyfill-php56": "^1.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^4.0|^5.0"
    },
    "autoload": {
        "psr-4": {
            "SuperClosure\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "SuperClosure\\Test\\": "tests/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-master": "2.4-dev"
        }
    },
    "replace": {
        "jeremeamia/superclosure": "self.version"
    },
    "version": "2.4.1"
}
